#!/usr/bin/env python3
"""
Blocks any commit containing a Supabase credential.

Install once per clone:
    git config core.hooksPath .githooks

Lives in the repo (not .git/hooks) so it survives cloning and any
teammate gets the same protection.

It deliberately ALLOWS the anon/publishable key, which is public by
design and has to ship with the site. It blocks everything else.
"""
import base64
import json
import re
import subprocess
import sys

TOKEN_PATTERNS = [
    (re.compile(r"sbp_[A-Za-z0-9]{20,}"),        "Supabase personal access token (sbp_...)"),
    (re.compile(r"sb_secret_[A-Za-z0-9]{10,}"),  "Supabase secret key (sb_secret_...)"),
    (re.compile(r"postgres(?:ql)?://[^:\s]+:[^@\s]+@"), "Postgres connection string with password"),
    (re.compile(r"(?i)(access[_-]?token|api[_-]?secret|db[_-]?password)\s*[:=]\s*['\"][^'\"]{12,}"),
     "hardcoded credential assignment"),
]

JWT = re.compile(r"eyJ[A-Za-z0-9_-]{8,}\.([A-Za-z0-9_-]{8,})\.[A-Za-z0-9_-]{8,}")
BINARY = (".png", ".jpg", ".jpeg", ".gif", ".webp", ".pdf", ".ico", ".woff", ".woff2")


def jwt_role(payload_b64):
    """Return the role claim of a Supabase JWT, or None if undecodable."""
    try:
        pad = payload_b64 + "=" * (-len(payload_b64) % 4)
        return json.loads(base64.urlsafe_b64decode(pad)).get("role")
    except Exception:
        return None


def staged_files():
    out = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True,
    ).stdout
    return [f for f in out.splitlines() if f.strip()]


def staged_content(path):
    r = subprocess.run(["git", "show", f":{path}"], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def main():
    problems = []

    for path in staged_files():
        if path.lower().endswith(BINARY):
            continue
        content = staged_content(path)
        if not content:
            continue

        for pattern, label in TOKEN_PATTERNS:
            if pattern.search(content):
                problems.append((path, label))

        for match in JWT.finditer(content):
            role = jwt_role(match.group(1))
            if role == "anon":
                continue          # public by design — fine to commit
            problems.append((path, f"JWT with role={role or 'unknown'} (only anon may be committed)"))

    if problems:
        sys.stderr.write("\n  COMMIT BLOCKED — credentials detected\n\n")
        for path, label in problems:
            sys.stderr.write(f"    {path}\n      → {label}\n")
        sys.stderr.write(
            "\n  Move the value into an environment variable or your password\n"
            "  manager, then commit again.\n\n"
            "  If this is a false positive, bypass with:  git commit --no-verify\n\n"
        )
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
